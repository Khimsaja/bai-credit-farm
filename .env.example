# B.AI Credit Farm — Environment Variables

# === 2Captcha (Turnstile solver) ===
B_AI_2CAP_KEY=your_2captcha_api_key_here

# === Email accounts ===
B_AI_EMAIL_PASSWORD=your_email_password
B_AI_EMAIL_DOMAIN=yourdomain.com

# === Worker config (Worker 1: batch_nvwz.py) ===
B_AI_TOTAL_ACCOUNTS=250
B_AI_ACCOUNT_PREFIX=user
B_AI_KEY_DIR=./keys
B_AI_PROFILE_BASE=/tmp/bai_profile
B_AI_RESULTS_FILE=results.json

# === Worker 2 config (batch_nvwz_w2.py) ===
# B_AI_WORKER_START=126
# B_AI_WORKER_END=250
# B_AI_WORKER_SUFFIX=w2

# === Turnstile (usually fixed) ===
# B_AI_TURNSTILE_SITEKEY=0x4AAAAAADKhTSXIozuHjOoF
